{
  "manifest_version": 3,
  "name": "JobFit — Resume Matcher",
  "version": "1.2.0",
  "description": "Compare your resume with a job description on LinkedIn, Naukri, Indeed, or any job page.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1:8766/*", "http://localhost:8766/*"],
  "action": { "default_title": "Check job fit", "default_popup": "popup.html" }
}
